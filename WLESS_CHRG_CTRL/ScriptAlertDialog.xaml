<Window x:Class="WLESS_CHRG_CTRL.ScriptAlertDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Script Alert"
        Width="520" MinWidth="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="White"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtContext"
                   FontSize="12" FontWeight="SemiBold" Foreground="#2D7DD2"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1" Padding="14" Background="#F5F7FA"
                BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="4">
            <TextBlock x:Name="txtMessage" FontSize="14" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="STOP" Width="88" Margin="0,0,8,0"
                    Click="Stop_Click"/>
            <Button Content="PAUSE" Width="88" Margin="0,0,8,0"
                    Click="Pause_Click" IsCancel="True"/>
            <Button Content="CONTINUE" Width="96"
                    Click="Continue_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
