<Window x:Class="WLESS_CHRG_CTRL.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:ports="clr-namespace:System.IO.Ports;assembly=System.IO.Ports"
        Title="Settings" 
        Height="440" Width="520"
        MinHeight="370" MinWidth="450"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <ObjectDataProvider x:Key="ParityValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ports:Parity"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="StopBitsValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ports:StopBits"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Banned Ports -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" 
                   Content="Banned Ports:" 
                   FontWeight="Bold"/>
            <TextBox Grid.Row="1" 
                     x:Name="txtBannedPorts"
                     Height="30"
                     VerticalContentAlignment="Center"
                     Margin="0,5,0,0"
                     ToolTip="Enter port names to exclude, separated by semicolons"/>
        </Grid>

        <!-- Serial Settings -->
        <Border Grid.Row="1" 
                BorderBrush="Gray" 
                BorderThickness="1" 
                Padding="10" 
                CornerRadius="4"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" 
                       Content="Serial Port Configuration" 
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Baud Rate: lista statica, non cambia mai -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,8,0">
                        <Label Content="Baud Rate:" FontSize="11"/>
                        <ComboBox x:Name="cbBaudRate" 
                                  IsEditable="True"
                                  SelectionChanged="Cb_SelectionChanged"
                                  KeyUp="CbBaudRate_KeyUp"
                                  ToolTip="Serial baud rate (or type a custom value)">
                            <sys:String>9600</sys:String>
                            <sys:String>19200</sys:String>
                            <sys:String>38400</sys:String>
                            <sys:String>57600</sys:String>
                            <sys:String>115200</sys:String>
                            <sys:String>230400</sys:String>
                            <sys:String>460800</sys:String>
                            <sys:String>921600</sys:String>
                        </ComboBox>
                    </StackPanel>

                    <!-- Data Bits: lista statica, non cambia mai -->
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,8,0">
                        <Label Content="Data Bits:" FontSize="11"/>
                        <ComboBox x:Name="cbDataBits" 
                                  IsEditable="False"
                                  SelectionChanged="Cb_SelectionChanged"
                                  ToolTip="Data bits (5-8)">
                            <sys:String>5</sys:String>
                            <sys:String>6</sys:String>
                            <sys:String>7</sys:String>
                            <sys:String>8</sys:String>
                        </ComboBox>
                    </StackPanel>

                    <!-- Parity: enum come ItemsSource -->
                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,8,0">
                        <Label Content="Parity:" FontSize="11"/>
                        <ComboBox x:Name="cbParity" 
                                  IsEditable="False"
                                  ItemsSource="{Binding Source={StaticResource ParityValues}}"
                                  SelectionChanged="Cb_SelectionChanged"
                                  ToolTip="Parity check"/>
                    </StackPanel>

                    <!-- Stop Bits: enum come ItemsSource -->
                    <StackPanel Grid.Column="3" Grid.Row="0">
                        <Label Content="Stop Bits:" FontSize="11"/>
                        <ComboBox x:Name="cbStopBits" 
                                  IsEditable="False"
                                  ItemsSource="{Binding Source={StaticResource StopBitsValues}}"
                                  SelectionChanged="Cb_SelectionChanged"
                                  ToolTip="Stop bits"/>
                    </StackPanel>

                    <!-- Current config display -->
                    <TextBlock Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="4"
                               x:Name="txtCurrentConfig"
                               Text="Current: 115200, 8, N, 1"
                               Foreground="Gray"
                               FontSize="10"
                               Margin="0,8,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Info -->
        <TextBlock Grid.Row="2" 
                   Text="These settings will be applied to both Station and Vehicle serial ports." 
                   Foreground="Gray" 
                   VerticalAlignment="Bottom"
                   TextWrapping="Wrap"/>

        <!-- Status locale alla dialog -->
        <TextBlock Grid.Row="3" 
                   x:Name="txtStatus"
                   Text=""
                   Foreground="SeaGreen"
                   FontSize="11"
                   Margin="0,4,0,0"/>

        <!-- Pulsanti -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="btnCancel" 
                    Content="Cancel" 
                    Click="BtnCancel_Click"
                    Padding="20,5" 
                    Margin="0,0,10,0"
                    IsCancel="True"/>
            <Button x:Name="btnApply" 
                    Content="Apply" 
                    Click="BtnApply_Click"
                    Padding="20,5" 
                    Margin="0,0,10,0"/>
            <Button x:Name="btnSave" 
                    Content="Save" 
                    Click="BtnSave_Click"
                    Padding="20,5"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>