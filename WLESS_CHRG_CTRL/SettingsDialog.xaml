<Window x:Class="WLESS_CHRG_CTRL.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:ports="clr-namespace:System.IO.Ports;assembly=System.IO.Ports"
        Title="Settings" 
        Height="480" Width="540"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>
        <ObjectDataProvider x:Key="ParityValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ports:Parity"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="StopBitsValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ports:StopBits"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Banned ports card -->
            <RowDefinition Height="Auto"/>
            <!-- Serial config card -->
            <RowDefinition Height="*"/>
            <!-- Info + spacer -->
            <RowDefinition Height="Auto"/>
            <!-- Status -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- ============ Banned Ports ============ -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="BANNED PORTS" Style="{StaticResource SectionCaption}"/>
                <TextBox Grid.Row="1" 
                         x:Name="txtBannedPorts"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,8,0,0"
                         ToolTip="Enter port names to exclude, separated by semicolons"/>
            </Grid>
        </Border>

        <!-- ============ Serial Port Configuration ============ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="SERIAL PORT CONFIGURATION" 
                           Style="{StaticResource SectionCaption}" Margin="0,0,0,10"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Baud Rate -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Baud Rate" Style="{StaticResource SectionCaption}" 
                                   FontSize="10" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cbBaudRate" 
                                  IsEditable="True"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="Cb_SelectionChanged"
                                  KeyUp="CbBaudRate_KeyUp"
                                  ToolTip="Serial baud rate (or type a custom value)">
                            <sys:String>9600</sys:String>
                            <sys:String>19200</sys:String>
                            <sys:String>38400</sys:String>
                            <sys:String>57600</sys:String>
                            <sys:String>115200</sys:String>
                            <sys:String>230400</sys:String>
                            <sys:String>460800</sys:String>
                            <sys:String>921600</sys:String>
                        </ComboBox>
                    </StackPanel>

                    <!-- Data Bits -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data Bits" Style="{StaticResource SectionCaption}" 
                                   FontSize="10" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cbDataBits" 
                                  IsEditable="False"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="Cb_SelectionChanged"
                                  ToolTip="Data bits (5-8)">
                            <sys:String>5</sys:String>
                            <sys:String>6</sys:String>
                            <sys:String>7</sys:String>
                            <sys:String>8</sys:String>
                        </ComboBox>
                    </StackPanel>

                    <!-- Parity -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Parity" Style="{StaticResource SectionCaption}" 
                                   FontSize="10" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cbParity" 
                                  IsEditable="False"
                                  Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding Source={StaticResource ParityValues}}"
                                  SelectionChanged="Cb_SelectionChanged"
                                  ToolTip="Parity check"/>
                    </StackPanel>

                    <!-- Stop Bits -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Stop Bits" Style="{StaticResource SectionCaption}" 
                                   FontSize="10" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cbStopBits" 
                                  IsEditable="False"
                                  Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding Source={StaticResource StopBitsValues}}"
                                  SelectionChanged="Cb_SelectionChanged"
                                  ToolTip="Stop bits"/>
                    </StackPanel>
                </Grid>

                <!-- Current config come badge -->
                <Border Grid.Row="2" Style="{StaticResource InfoBadge}" 
                        HorizontalAlignment="Left" Margin="0,14,0,0">
                    <TextBlock x:Name="txtCurrentConfig"
                               Text="Current: 115200, 8, N, 1"
                               Foreground="#2D7DD2"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Info ============ -->
        <TextBlock Grid.Row="2" 
                   Text="These settings will be applied to both Station and Vehicle serial ports." 
                   Foreground="#888888" 
                   FontSize="11"
                   VerticalAlignment="Bottom"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"/>

        <!-- ============ Status ============ -->
        <TextBlock Grid.Row="3" 
                   x:Name="txtStatus"
                   Text=""
                   Foreground="SeaGreen"
                   FontSize="11"
                   Margin="0,4,0,0"/>

        <!-- ============ Buttons ============ -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="btnCancel" 
                    Content="CANCEL" 
                    Click="BtnCancel_Click"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button x:Name="btnApply" 
                    Content="APPLY" 
                    Click="BtnApply_Click"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"/>
            <Button x:Name="btnSave" 
                    Content="SAVE" 
                    Click="BtnSave_Click"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>