<Window x:Class="WLESS_CHRG_CTRL.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" 
        Height="420" Width="520"
        MinHeight="350" MinWidth="450"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Banned Ports -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" 
                   Content="Banned Ports (separated by ';'):" 
                   FontWeight="Bold"/>
            <TextBox Grid.Row="1" 
                     x:Name="txtBannedPorts"
                     Height="30"
                     VerticalContentAlignment="Center"
                     Margin="0,5,0,0"
                     ToolTip="Enter port names to exclude, separated by semicolons"/>
        </Grid>

        <!-- Serial Settings -->
        <Border Grid.Row="1" 
                BorderBrush="Gray" 
                BorderThickness="1" 
                Padding="10" 
                CornerRadius="4"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" 
                       Content="Serial Port Configuration (shared for Station and Vehicle)" 
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Baud Rate -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,8,0">
                        <Label Content="Baud Rate:" FontSize="11"/>
                        <ComboBox x:Name="cbBaudRate" 
                                  IsEditable="True"
                                  ToolTip="Serial baud rate"/>
                    </StackPanel>

                    <!-- Data Bits -->
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,8,0">
                        <Label Content="Data Bits:" FontSize="11"/>
                        <ComboBox x:Name="cbDataBits" 
                                  IsEditable="False"
                                  ToolTip="Data bits (5-8)"/>
                    </StackPanel>

                    <!-- Parity -->
                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,8,0">
                        <Label Content="Parity:" FontSize="11"/>
                        <ComboBox x:Name="cbParity" 
                                  IsEditable="False"
                                  ToolTip="Parity check"/>
                    </StackPanel>

                    <!-- Stop Bits -->
                    <StackPanel Grid.Column="3" Grid.Row="0">
                        <Label Content="Stop Bits:" FontSize="11"/>
                        <ComboBox x:Name="cbStopBits" 
                                  IsEditable="False"
                                  ToolTip="Stop bits"/>
                    </StackPanel>

                    <!-- Current config display -->
                    <TextBlock Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="4"
                               x:Name="txtCurrentConfig"
                               Text="Current: 115200, 8, N, 1"
                               Foreground="Gray"
                               FontSize="10"
                               Margin="0,8,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Info -->
        <TextBlock Grid.Row="2" 
                   Text="These settings will be applied to both Station and Vehicle serial ports." 
                   Foreground="Gray" 
                   VerticalAlignment="Bottom"
                   TextWrapping="Wrap"/>

        <!-- Pulsanti -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="btnCancel" 
                    Content="Cancel" 
                    Click="BtnCancel_Click"
                    Padding="20,5" 
                    Margin="0,0,10,0"
                    IsCancel="True"/>
            <Button x:Name="btnApply" 
                    Content="Apply" 
                    Click="BtnApply_Click"
                    Padding="20,5" 
                    Margin="0,0,10,0"/>
            <Button x:Name="btnSave" 
                    Content="Save" 
                    Click="BtnSave_Click"
                    Padding="20,5"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>