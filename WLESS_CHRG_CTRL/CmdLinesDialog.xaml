<Window x:Class="WLESS_CHRG_CTRL.CmdLinesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Command Lines" 
        Height="400" Width="500"
        MinHeight="300" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Intestazione -->
        <TextBlock Grid.Row="0" 
                   Text="Enter commands (one per line):" 
                   Margin="0,0,0,5"/>

        <!-- TextBox multilinea comandi -->
        <TextBox Grid.Row="1" 
                 x:Name="txtCmdLines"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"/>

        <!-- Pannello Delay -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    Margin="0,10,0,0">
            <Label Content="Delay between commands (ms):" 
                   VerticalAlignment="Center"/>
            <xctk:IntegerUpDown x:Name="nudDelay" 
                     Width="80" 
                     VerticalContentAlignment="Center"
                     Value="500" Minimum="0" />
        </StackPanel>

        <!-- Pulsanti -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button x:Name="btnSend" 
                    Content="Send" 
                    Click="BtnSend_Click"
                    Padding="20,5" 
                    Margin="0,0,10,0"
                    IsDefault="True"/>
            <Button x:Name="btnCancel" 
                    Content="Cancel" 
                    Click="BtnCancel_Click"
                    Padding="20,5"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>