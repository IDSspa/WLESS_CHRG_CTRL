<Window x:Class="WLESS_CHRG_CTRL.CmdLinesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Command Lines" 
        Height="420" Width="520"
        MinHeight="320" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="MULTI-LINE COMMANDS" Style="{StaticResource SectionCaption}"/>
            <TextBlock Text="Enter one command per line" 
                       FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- TextBox multilinea comandi -->
        <Border Grid.Row="1" CornerRadius="8" BorderBrush="#CCCCCC" BorderThickness="1">
            <TextBox x:Name="txtCmdLines"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="10"
                     BorderThickness="0"
                     Background="#FCFCFC"/>
        </Border>

        <!-- Pannello Delay -->
        <Border Grid.Row="2" Style="{StaticResource InfoBadge}"
                HorizontalAlignment="Left" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Delay between commands:" 
                           VerticalAlignment="Center" FontSize="11" 
                           Foreground="#2D7DD2" FontWeight="SemiBold"/>
                <xctk:IntegerUpDown x:Name="nudDelay" 
                         Width="70" 
                         Height="24"
                         Margin="8,0,0,0"
                         VerticalContentAlignment="Center"
                         BorderThickness="1"
                         BorderBrush="#B7D3EE"
                         Background="White"
                         Value="500" Minimum="0" />
                <TextBlock Text="ms" VerticalAlignment="Center" Margin="4,0,0,0" 
                           FontSize="11" Foreground="#2D7DD2"/>
            </StackPanel>
        </Border>

        <!-- Pulsanti -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="btnCancel" 
                    Content="CANCEL" 
                    Click="BtnCancel_Click"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button x:Name="btnSend" 
                    Content="SEND" 
                    Click="BtnSend_Click"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>