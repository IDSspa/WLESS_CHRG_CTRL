<Window x:Class="WLESS_CHRG_CTRL.StatusDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parsed Status - UQ Response" 
        Height="750" Width="550"
        MinHeight="400" MinWidth="450"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Parsed UQ? Response" 
                   FontSize="16" 
                   FontWeight="Bold" 
                   Margin="0,0,0,10"/>

        <ListView Grid.Row="1" 
                  x:Name="lvValues"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Field" Width="260" DisplayMemberBinding="{Binding FieldName}"/>
                    <GridViewColumn Header="Value" Width="240" DisplayMemberBinding="{Binding FieldValue}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Button Grid.Row="2" 
                Content="Close" 
                Click="BtnClose_Click"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                Padding="20,5"/>
    </Grid>
</Window>