<Window x:Class="WLESS_CHRG_CTRL.StatusDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parsed Status - UQ Response" 
        Height="750" Width="550"
        MinHeight="400" MinWidth="450"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="PARSED RESPONSE" 
                       Style="{StaticResource SectionCaption}"/>
            <TextBlock x:Name="txtHeaderTitle"
                       Text="UQ? Response" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Field/Value list -->
        <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True"
                BorderBrush="#E2E2E2" BorderThickness="1">
            <ListView Grid.Row="1" 
                      x:Name="lvValues"
                      Style="{StaticResource ModernListView}"
                      ItemContainerStyle="{StaticResource ModernListViewItem}"
                      BorderThickness="0"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource FlatGridViewHeader}">
                        <GridViewColumn Header="Field" Width="260" DisplayMemberBinding="{Binding FieldName}"/>
                        <GridViewColumn Header="Value" Width="240" DisplayMemberBinding="{Binding FieldValue}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Close -->
        <Button Grid.Row="2" 
                Content="CLOSE" 
                Click="BtnClose_Click"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"/>
    </Grid>
</Window>