<Window x:Class="WLESS_CHRG_CTRL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WLESS CHRG CTRL - Serial Monitor" 
        Height="700" Width="1000"
        MinHeight="500" MinWidth="700">

    <Window.Resources>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource ModernListViewItem}">
            <Setter Property="Foreground" Value="{Binding TextColor}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Load _Station Script..." Click="MenuLoadStationScript_Click"/>
                <MenuItem Header="Load _Vehicle Script..." Click="MenuLoadVehicleScript_Click"/>
                <Separator/>
                <MenuItem Header="_Settings..." Click="MenuSettings_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="MenuExit_Click"/>
            </MenuItem>
        </Menu>

        <!-- Contenuto principale -->
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titolo -->
            <TextBlock Grid.Row="0" 
                       Text="WLESS CHRG CTRL" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- Sezione Porte Seriali -->
            <Grid Grid.Row="1" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Station -->
                <Border Grid.Column="0" Style="{StaticResource ConnectionCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse x:Name="ledStation" Width="9" Height="9" Fill="Gray"
                                     VerticalAlignment="Center" Margin="0,0,8,0"
                                     ToolTip="Station connection status"/>
                            <TextBlock Text="STATION" FontWeight="SemiBold" FontSize="12"
                                       Foreground="#444" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="cbStationPort" Style="{StaticResource PortComboBox}"
                                      ToolTip="Select station serial port"/>
                            <Button Grid.Column="2" x:Name="btnStationConnect" Content="CONNECT"
                                    Click="BtnStationConnect_Click" Style="{StaticResource ConnectButton}"
                                    ToolTip="Open/Close Station connection"/>
                        </Grid>

                        <TextBlock Grid.Row="2" x:Name="lblStationRole" Text=""
                                   Foreground="DodgerBlue" FontSize="11" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- Vehicle -->
                <Border Grid.Column="2" Style="{StaticResource ConnectionCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                            <TextBlock Text="VEHICLE" FontWeight="SemiBold" FontSize="12"
                                       Foreground="#444" VerticalAlignment="Center"/>
                            <Ellipse x:Name="ledVehicle" Width="9" Height="9" Fill="Gray"
                                     VerticalAlignment="Center" Margin="8,0,0,0"
                                     ToolTip="Vehicle connection status"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="btnVehicleConnect" Content="CONNECT"
                                    Click="BtnVehicleConnect_Click" Style="{StaticResource ConnectButton}"
                                    ToolTip="Open/Close Vehicle connection"/>
                            <ComboBox Grid.Column="2" x:Name="cbVehiclePort" Style="{StaticResource PortComboBox}"
                                      ToolTip="Select vehicle serial port"/>
                        </Grid>

                        <TextBlock Grid.Row="2" x:Name="lblVehicleRole" Text=""
                                   Foreground="DodgerBlue" FontSize="11"
                                   HorizontalAlignment="Right" Margin="0,8,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Sezione ListView Messaggi -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Station Messages -->
                <Border Grid.Column="0" 
                        Style="{StaticResource CardBorder}" 
                        Padding="0"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="STATION MESSAGES" 
                                   Style="{StaticResource SectionCaption}"
                                   Padding="12,10,12,8"/>

                        <ListView Grid.Row="1" 
                                  x:Name="lvStationMessages" 
                                  Style="{StaticResource ModernListView}"
                                  BorderThickness="0"
                                  SelectionMode="Extended"
                                  KeyDown="LvMessages_KeyDown"
                                  MouseDoubleClick="LvMessages_MouseDoubleClick"
                                  Loaded="LvStationMessages_Loaded"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ContextMenuOpening="Station_ContextMenuOpening">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Parse message..." Click="MenuParseStation_Click" Name="MenuParseStation"/>
                                    <Separator/>
                                    <MenuItem Header="Clear All" Click="MenuClearStation_Click" Name="MenuClearStation"/>
                                    <Separator/>
                                    <MenuItem Header="Save to File..." Click="MenuSaveStation_Click" Name="MenuSaveStation"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView x:Name="gvStation" ColumnHeaderContainerStyle="{StaticResource FlatGridViewHeader}">
                                    <GridViewColumn Header="Time" Width="90" DisplayMemberBinding="{Binding Time}"/>
                                    <GridViewColumn x:Name="gvcStationMessage" Header="Message" Width="380" DisplayMemberBinding="{Binding Message}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Vehicle Messages -->
                <Border Grid.Column="2" 
                        Style="{StaticResource CardBorder}" 
                        Padding="0"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="VEHICLE MESSAGES" 
                                   Style="{StaticResource SectionCaption}"
                                   HorizontalAlignment="Right"
                                   Padding="12,10,12,8"/>

                        <ListView Grid.Row="1" 
                                  x:Name="lvVehicleMessages" 
                                  Style="{StaticResource ModernListView}"
                                  BorderThickness="0"
                                  SelectionMode="Extended"
                                  KeyDown="LvMessages_KeyDown"
                                  MouseDoubleClick="LvMessages_MouseDoubleClick"
                                  Loaded="LvVehicleMessages_Loaded"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ContextMenuOpening="Vehicle_ContextMenuOpening" 
                                  AllowDrop="True" 
                                  DragEnter="VehicleCommand_DragEnter" 
                                  Drop="VehicleCommand_Drop">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Parse message..." Click="MenuParseVehicle_Click" Name="MenuParseVehicle"/>
                                    <Separator/>
                                    <MenuItem Header="Clear All" Click="MenuClearVehicle_Click" Name="MenuClearVehicle"/>
                                    <Separator/>
                                    <MenuItem Header="Save to File..." Click="MenuSaveVehicle_Click" Name="MenuSaveVehicle"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView x:Name="gvVehicle" ColumnHeaderContainerStyle="{StaticResource FlatGridViewHeader}">
                                    <GridViewColumn Header="Time" Width="90" DisplayMemberBinding="{Binding Time}"/>
                                    <GridViewColumn x:Name="gvcVehicleMessage" Header="Message" Width="380" DisplayMemberBinding="{Binding Message}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Sezione Comandi -->
            <Grid Grid.Row="3" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Station commands -->
                <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True"><Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="STATION SCRIPT" Style="{StaticResource SectionCaption}" Padding="12,10,12,8"/>
                    <ListView Grid.Row="1" x:Name="lvStationScript" Style="{StaticResource ModernListView}" BorderThickness="0" AllowDrop="True" HorizontalContentAlignment="Stretch" ContextMenuOpening="Script_ContextMenuOpening"
                              PreviewDragEnter="StationCommand_DragEnter" PreviewDragOver="StationCommand_DragEnter" PreviewDrop="StationCommand_Drop">
                        <ListView.ContextMenu><ContextMenu><MenuItem Header="Save script..." Click="SaveStationScript_Click"/><Separator/><MenuItem Header="Clear script" Click="ClearStationScript_Click"/></ContextMenu></ListView.ContextMenu>
                        <ListView.View><GridView ColumnHeaderContainerStyle="{StaticResource FlatGridViewHeader}"><GridViewColumn Header="Pos" Width="42" DisplayMemberBinding="{Binding Position}"/><GridViewColumn Header="Command" Width="250"><GridViewColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="Delay" Width="75"><GridViewColumn.CellTemplate><DataTemplate><TextBox Text="{Binding DelayText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" ToolTip="Empty = default delay" KeyDown="ScriptDelay_KeyDown"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn></GridView></ListView.View>
                    </ListView>
                    <TextBox Grid.Row="1" x:Name="txtStationScript" Height="110" AcceptsReturn="True"
                             Visibility="Collapsed"
                             TextWrapping="NoWrap" FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             AllowDrop="True" PreviewDragEnter="StationCommand_DragEnter"
                             PreviewDragOver="StationCommand_DragEnter" PreviewDrop="StationCommand_Drop"
                             ToolTip="Drop a .wcx script here"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button Content="▶" ToolTip="Run script" Width="28" Margin="2,0" Click="StationPlay_Click"/>
                        <Button Content="Ⅱ" ToolTip="Pause or resume script" Width="28" Margin="2,0" Click="StationPause_Click"/>
                        <Button Content="▶|" ToolTip="Step forward" Width="28" Margin="2,0" Click="StationStep_Click"/>
                        <Button Content="■" ToolTip="Stop script" Width="28" Margin="2,0" Click="StationStop_Click"/>
                        <Button Content="+" ToolTip="Insert command" Width="28" Margin="2,0" Click="StationAddCommand_Click"/>
                        <Button Content="−" ToolTip="Remove selected command" Width="28" Margin="2,0" Click="StationRemoveCommand_Click"/>
                        <Button Content="↑" ToolTip="Move command up" Width="28" Margin="2,0" Click="StationMoveUp_Click"/>
                        <Button Content="↓" ToolTip="Move command down" Width="28" Margin="2,0" Click="StationMoveDown_Click"/>
                    </StackPanel>
                </Grid></Border><StackPanel Grid.Row="1" Margin="0,8,0,0"><Label Content="Station Command (press ENTER to send):"/><TextBox x:Name="txtStationCommand" Height="30" VerticalContentAlignment="Center" KeyDown="TxtStationCommand_KeyDown" ToolTip="ENTER to send single command"/></StackPanel></Grid>

                <!-- Vehicle commands -->
                <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True"><Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="VEHICLE SCRIPT" Style="{StaticResource SectionCaption}" HorizontalAlignment="Right" Padding="12,10,12,8"/>
                    <ListView Grid.Row="1" x:Name="lvVehicleScript" Style="{StaticResource ModernListView}" BorderThickness="0" AllowDrop="True" HorizontalContentAlignment="Stretch" ContextMenuOpening="Script_ContextMenuOpening"
                              PreviewDragEnter="VehicleCommand_DragEnter" PreviewDragOver="VehicleCommand_DragEnter" PreviewDrop="VehicleCommand_Drop">
                        <ListView.ContextMenu><ContextMenu><MenuItem Header="Save script..." Click="SaveVehicleScript_Click"/><Separator/><MenuItem Header="Clear script" Click="ClearVehicleScript_Click"/></ContextMenu></ListView.ContextMenu>
                        <ListView.View><GridView ColumnHeaderContainerStyle="{StaticResource FlatGridViewHeader}"><GridViewColumn Header="Pos" Width="42" DisplayMemberBinding="{Binding Position}"/><GridViewColumn Header="Command" Width="250"><GridViewColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="Delay" Width="75"><GridViewColumn.CellTemplate><DataTemplate><TextBox Text="{Binding DelayText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" ToolTip="Empty = default delay" KeyDown="ScriptDelay_KeyDown"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn></GridView></ListView.View>
                    </ListView>
                    <TextBox Grid.Row="1" x:Name="txtVehicleScript" Height="110" AcceptsReturn="True"
                             Visibility="Collapsed"
                             TextWrapping="NoWrap" FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             AllowDrop="True" PreviewDragEnter="VehicleCommand_DragEnter"
                             PreviewDragOver="VehicleCommand_DragEnter" PreviewDrop="VehicleCommand_Drop"
                             ToolTip="Drop a .wcx script here"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button Content="▶" ToolTip="Run script" Width="28" Margin="2,0" Click="VehiclePlay_Click"/>
                        <Button Content="Ⅱ" ToolTip="Pause or resume script" Width="28" Margin="2,0" Click="VehiclePause_Click"/>
                        <Button Content="▶|" ToolTip="Step forward" Width="28" Margin="2,0" Click="VehicleStep_Click"/>
                        <Button Content="■" ToolTip="Stop script" Width="28" Margin="2,0" Click="VehicleStop_Click"/>
                        <Button Content="+" ToolTip="Insert command" Width="28" Margin="2,0" Click="VehicleAddCommand_Click"/>
                        <Button Content="−" ToolTip="Remove selected command" Width="28" Margin="2,0" Click="VehicleRemoveCommand_Click"/>
                        <Button Content="↑" ToolTip="Move command up" Width="28" Margin="2,0" Click="VehicleMoveUp_Click"/>
                        <Button Content="↓" ToolTip="Move command down" Width="28" Margin="2,0" Click="VehicleMoveDown_Click"/>
                    </StackPanel>
                </Grid></Border><StackPanel Grid.Row="1" Margin="0,8,0,0"><Label Content="Vehicle Command (press ENTER to send):" HorizontalAlignment="Right"/><TextBox x:Name="txtVehicleCommand" Height="30" VerticalContentAlignment="Center" KeyDown="TxtVehicleCommand_KeyDown" ToolTip="ENTER to send single command"/></StackPanel></Grid>
            </Grid>

            <!-- Status Bar -->
            <StatusBar Grid.Row="4" 
                       Margin="0,10,0,0">
                <StatusBarItem>
                    <TextBlock x:Name="txtStatus" Text="Ready - Select serial ports and click CONNECT"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </DockPanel>
</Window>
