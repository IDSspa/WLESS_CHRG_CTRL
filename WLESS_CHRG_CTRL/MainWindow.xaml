<Window x:Class="WLESS_CHRG_CTRL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WLESS CHRG CTRL - Serial Monitor" 
        Height="700" Width="1000"
        MinHeight="500" MinWidth="700">

    <Window.Resources>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{Binding TextColor}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings..." Click="MenuSettings_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="MenuExit_Click"/>
            </MenuItem>
        </Menu>

        <!-- Contenuto principale (esistente, wrappato in Grid) -->
        <Grid Margin="15">
            <!-- ... tutto il contenuto precedente ... -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titolo -->
            <TextBlock Grid.Row="0" 
                       Text="WLESS CHRG CTRL" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- Sezione Porte Seriali -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Station Port -->
                <Border Grid.Column="0" 
                        BorderBrush="Gray" 
                        BorderThickness="1" 
                        Padding="12" 
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Label Content="STATION PORT:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbStationPort" 
                                      Width="120" 
                                      VerticalAlignment="Center"
                                      ToolTip="Seleziona la porta seriale della stazione"/>
                            <Ellipse x:Name="ledStation" 
                                     Width="14" 
                                     Height="14" 
                                     Fill="Gray" 
                                     Margin="10,0,0,0" 
                                     VerticalAlignment="Center"
                                     ToolTip="Stato connessione stazione"/>
                        </StackPanel>
                        <Label Grid.Row="1" 
                               x:Name="lblStationRole" 
                               Content="" 
                               Foreground="DodgerBlue"
                               FontSize="11"
                               Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="2" 
                                   Text="Config: 115200, 8, N, 1" 
                                   Foreground="Gray" 
                                   FontSize="10"/>
                    </Grid>
                </Border>

                <!-- Pulsante Connect Centrale -->
                <Button Grid.Column="1" 
                        x:Name="btnConnect" 
                        Content="CONNECT" 
                        Click="BtnConnect_Click"
                        Margin="20,0"
                        VerticalAlignment="Center"
                        ToolTip="Apri/Chiudi le connessioni seriali"/>

                <!-- Vehicle Port -->
                <Border Grid.Column="2" 
                        BorderBrush="Gray" 
                        BorderThickness="1" 
                        Padding="12" 
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" HorizontalAlignment="Right">
                            <Ellipse x:Name="ledVehicle" 
                                     Width="14" 
                                     Height="14" 
                                     Fill="Gray" 
                                     Margin="0,0,10,0" 
                                     VerticalAlignment="Center"
                                     ToolTip="Stato connessione veicolo"/>
                            <ComboBox x:Name="cbVehiclePort" 
                                      Width="120" 
                                      VerticalAlignment="Center"
                                      ToolTip="Seleziona la porta seriale del veicolo"/>
                            <Label Content=":VEHICLE PORT" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Label Grid.Row="1" 
                               x:Name="lblVehicleRole" 
                               Content="" 
                               Foreground="DodgerBlue"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="2" 
                                   Text="Config: 115200, 8, N, 1" 
                                   Foreground="Gray" 
                                   FontSize="10"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Sezione ListView Messaggi -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Station Messages -->
                <Border Grid.Column="0" 
                        BorderBrush="Gray" 
                        BorderThickness="1" 
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" 
                               Content="STATION MESSAGES" 
                               Background="LightGray" 
                               Padding="8,4"/>
                        <ListView Grid.Row="1" 
                                  x:Name="lvStationMessages" 
                                  Margin="4"
                                  BorderThickness="0"
                                  SelectionMode="Extended"
                                  KeyDown="LvMessages_KeyDown"
                                  Loaded="LvStationMessages_Loaded"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ContextMenuOpening="Station_ContextMenuOpening">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Parse status..." Click="MenuParseStation_Click" Name="MenuParseStation"/>
                                    <Separator/>
                                    <MenuItem Header="Clear All" Click="MenuClearStation_Click" Name="MenuClearStation"/>
                                    <Separator/>
                                    <MenuItem Header="Save to File..." Click="MenuSaveStation_Click" Name="MenuSaveStation"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView x:Name="gvStation">
                                    <GridViewColumn Header="Time" Width="90" DisplayMemberBinding="{Binding Time}"/>
                                    <GridViewColumn x:Name="gvcStationMessage" Header="Message" Width="380" DisplayMemberBinding="{Binding Message}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Vehicle Messages -->
                <Border Grid.Column="2" 
                        BorderBrush="Gray" 
                        BorderThickness="1" 
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" 
                               Content="VEHICLE MESSAGES" 
                               Background="LightGray" 
                               Padding="8,4"
                               HorizontalContentAlignment="Right"/>
                        <ListView Grid.Row="1" 
                                  x:Name="lvVehicleMessages" 
                                  Margin="4"
                                  BorderThickness="0"
                                  SelectionMode="Extended"
                                  KeyDown="LvMessages_KeyDown"
                                  Loaded="LvVehicleMessages_Loaded"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ContextMenuOpening="Vehicle_ContextMenuOpening">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Parse status..." Click="MenuParseVehicle_Click" Name="MenuParseVehicle"/>
                                    <Separator/>
                                    <MenuItem Header="Clear All" Click="MenuClearVehicle_Click" Name="MenuClearVehicle"/>
                                    <Separator/>
                                    <MenuItem Header="Save to File..." Click="MenuSaveVehicle_Click" Name="MenuSaveVehicle"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView x:Name="gvVehicle">
                                    <GridViewColumn Header="Time" Width="90" DisplayMemberBinding="{Binding Time}"/>
                                    <GridViewColumn x:Name="gvcVehicleMessage" Header="Message" Width="380" DisplayMemberBinding="{Binding Message}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Sezione Comandi -->
            <Grid Grid.Row="3" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Station Command -->
                <StackPanel Grid.Column="0">
                    <Label Content="Station Command (premi INVIO per inviare):"/>
                    <TextBox x:Name="txtStationCommand" 
                             Height="30" 
                             VerticalContentAlignment="Center"
                             KeyDown="TxtStationCommand_KeyDown"
                             MouseDoubleClick="TxtStationCommand_MouseDoubleClick"
                             ToolTip="Doppio click per aprire editor multi-linea / INVIO per inviare singolo comando"/>
                </StackPanel>

                <!-- Vehicle Command -->
                <StackPanel Grid.Column="2">
                    <Label Content="Vehicle Command (premi INVIO per inviare):" HorizontalAlignment="Right"/>
                    <TextBox x:Name="txtVehicleCommand" 
                             Height="30" 
                             VerticalContentAlignment="Center"
                             KeyDown="TxtVehicleCommand_KeyDown"
                             MouseDoubleClick="TxtVehicleCommand_MouseDoubleClick"
                             ToolTip="Doppio click per aprire editor multi-linea / INVIO per inviare singolo comando"/>
                </StackPanel>
            </Grid>

            <!-- Status Bar -->
            <StatusBar Grid.Row="4" 
                       Margin="0,10,0,0">
                <StatusBarItem>
                    <TextBlock x:Name="txtStatus" Text="Pronto - Seleziona le porte seriali e clicca CONNECT"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </DockPanel>
</Window>