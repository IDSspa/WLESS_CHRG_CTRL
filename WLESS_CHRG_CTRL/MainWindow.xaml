<Window x:Class="WLESS_CHRG_CTRL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WLESS CHRG CTRL - Serial Monitor" 
        Height="700" Width="1000"
        MinHeight="500" MinWidth="700">

    <Window.Resources>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{Binding TextColor}"/>
        </Style>

        <!-- Card per i pannelli di connessione -->
        <Style x:Key="ConnectionCard" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E2E2E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="8" ShadowDepth="1" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PortComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
        </Style>

        <!-- Bottone Connect/Disconnect in stile flat -->
        <Style x:Key="ConnectButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="92"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#2D7DD2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#256bb3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1c539c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings..." Click="MenuSettings_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="MenuExit_Click"/>
            </MenuItem>
        </Menu>

        <!-- Contenuto principale (esistente, wrappato in Grid) -->
        <Grid Margin="15">
            <!-- ... tutto il contenuto precedente ... -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- Sezione Porte Seriali -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Station -->
                <Border Grid.Column="0" Style="{StaticResource ConnectionCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header: LED + titolo -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse x:Name="ledStation" Width="9" Height="9" Fill="Gray"
                         VerticalAlignment="Center" Margin="0,0,8,0"
                         ToolTip="Station connection status"/>
                            <TextBlock Text="STATION" FontWeight="SemiBold" FontSize="12"
                           Foreground="#444" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Combo + Connect nella stessa riga -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="cbStationPort" Style="{StaticResource PortComboBox}"
                          ToolTip="Select station serial port"/>
                            <Button Grid.Column="2" x:Name="btnStationConnect" Content="CONNECT"
                        Click="BtnStationConnect_Click" Style="{StaticResource ConnectButton}"
                        ToolTip="Open/Close Station connection"/>
                        </Grid>

                        <!-- Ruolo -->
                        <TextBlock Grid.Row="2" x:Name="lblStationRole" Text=""
                       Foreground="DodgerBlue" FontSize="11" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- Vehicle (speculare) -->
                <Border Grid.Column="2" Style="{StaticResource ConnectionCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                            <TextBlock Text="VEHICLE" FontWeight="SemiBold" FontSize="12"
                           Foreground="#444" VerticalAlignment="Center"/>
                            <Ellipse x:Name="ledVehicle" Width="9" Height="9" Fill="Gray"
                         VerticalAlignment="Center" Margin="8,0,0,0"
                         ToolTip="Vehicle connection status"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="btnVehicleConnect" Content="CONNECT"
                        Click="BtnVehicleConnect_Click" Style="{StaticResource ConnectButton}"
                        ToolTip="Open/Close Vehicle connection"/>
                            <ComboBox Grid.Column="2" x:Name="cbVehiclePort" Style="{StaticResource PortComboBox}"
                          ToolTip="Select vehicle serial port"/>
                        </Grid>

                        <TextBlock Grid.Row="2" x:Name="lblVehicleRole" Text=""
                       Foreground="DodgerBlue" FontSize="11"
                       HorizontalAlignment="Right" Margin="0,8,0,0"/>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- Sezione ListView Messaggi -->
            <Grid Grid.Row="1" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Station Messages -->
                <Border Grid.Column="0" 
                        BorderBrush="Gray" 
                        BorderThickness="1" 
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" 
                               Content="STATION MESSAGES" 
                               Background="LightGray" 
                               Padding="8,4"/>
                        <ListView Grid.Row="1" 
                                  x:Name="lvStationMessages" 
                                  Margin="4"
                                  BorderThickness="0"
                                  SelectionMode="Extended"
                                  KeyDown="LvMessages_KeyDown"
                                  Loaded="LvStationMessages_Loaded"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ContextMenuOpening="Station_ContextMenuOpening">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Parse message..." Click="MenuParseStation_Click" Name="MenuParseStation"/>
                                    <Separator/>
                                    <MenuItem Header="Clear All" Click="MenuClearStation_Click" Name="MenuClearStation"/>
                                    <Separator/>
                                    <MenuItem Header="Save to File..." Click="MenuSaveStation_Click" Name="MenuSaveStation"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView x:Name="gvStation">
                                    <GridViewColumn Header="Time" Width="90" DisplayMemberBinding="{Binding Time}"/>
                                    <GridViewColumn x:Name="gvcStationMessage" Header="Message" Width="380" DisplayMemberBinding="{Binding Message}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Vehicle Messages -->
                <Border Grid.Column="2" 
                        BorderBrush="Gray" 
                        BorderThickness="1" 
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" 
                               Content="VEHICLE MESSAGES" 
                               Background="LightGray" 
                               Padding="8,4"
                               HorizontalContentAlignment="Right"/>
                        <ListView Grid.Row="1" 
                                  x:Name="lvVehicleMessages" 
                                  Margin="4"
                                  BorderThickness="0"
                                  SelectionMode="Extended"
                                  KeyDown="LvMessages_KeyDown"
                                  Loaded="LvVehicleMessages_Loaded"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ContextMenuOpening="Vehicle_ContextMenuOpening">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Parse message..." Click="MenuParseVehicle_Click" Name="MenuParseVehicle"/>
                                    <Separator/>
                                    <MenuItem Header="Clear All" Click="MenuClearVehicle_Click" Name="MenuClearVehicle"/>
                                    <Separator/>
                                    <MenuItem Header="Save to File..." Click="MenuSaveVehicle_Click" Name="MenuSaveVehicle"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView x:Name="gvVehicle">
                                    <GridViewColumn Header="Time" Width="90" DisplayMemberBinding="{Binding Time}"/>
                                    <GridViewColumn x:Name="gvcVehicleMessage" Header="Message" Width="380" DisplayMemberBinding="{Binding Message}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Sezione Comandi -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Station Command -->
                <StackPanel Grid.Column="0">
                    <Label Content="Station Command (press ENTER to send):"/>
                    <TextBox x:Name="txtStationCommand" 
                             Height="30" 
                             VerticalContentAlignment="Center"
                             KeyDown="TxtStationCommand_KeyDown"
                             MouseDoubleClick="TxtStationCommand_MouseDoubleClick"
                             ToolTip="Double click to open multi-line editor / ENTER to send single command"/>
                </StackPanel>

                <!-- Vehicle Command -->
                <StackPanel Grid.Column="2">
                    <Label Content="Vehicle Command (press ENTER to send):" HorizontalAlignment="Right"/>
                    <TextBox x:Name="txtVehicleCommand" 
                             Height="30" 
                             VerticalContentAlignment="Center"
                             KeyDown="TxtVehicleCommand_KeyDown"
                             MouseDoubleClick="TxtVehicleCommand_MouseDoubleClick"
                             ToolTip="Double click to open multi-line editor / ENTER to send single command"/>
                </StackPanel>
            </Grid>

            <!-- Status Bar -->
            <StatusBar Grid.Row="3" 
                       Margin="0,10,0,0">
                <StatusBarItem>
                    <TextBlock x:Name="txtStatus" Text="Ready - Select serial ports and click CONNECT"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </DockPanel>
</Window>